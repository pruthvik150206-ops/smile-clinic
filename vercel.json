{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "frontend/static/**",
          "public/**",
          "database/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/dms",
      "dest": "/dms.html"
    },
    {
      "src": "/portal",
      "dest": "/dms.html"
    },
    {
      "src": "/login",
      "dest": "/dms.html"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
