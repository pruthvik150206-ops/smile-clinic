{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "frontend/static/**",
          "public/**",
          "database/**"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/", "dest": "/public/landing.html" },
    { "src": "/landing", "dest": "/public/landing.html" },
    { "src": "/dms", "dest": "/public/dms.html" },
    { "src": "/portal", "dest": "/public/portal.html" },
    { "src": "/login", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
